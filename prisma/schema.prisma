generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BranchStatus {
  DONE
  ON_PROGRESS
  PENDING
}

enum MouStatus {
  DRAFT
  SUBMITTED
  DONE
  REJECTED
  APPROVED
}

enum PlacementStatus {
  NOT_STARTED
  ON_PROGRESS
  DONE
  ISSUE
}

enum EventStatus {
  UPCOMING
  ON_PROGRESS
  COMPLETED
  CANCELLED
}

enum OutletType {
  TRADITIONAL
  MODERN_RETAIL
  EXCLUSIVE
  CAMPUS_OUTLET
}

enum OutletStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum MaterialType {
  POSTER
  SHOPBLIND
  BANNER
  BRANDING_SIGNBOARD
  OTHER_MATERIALS
}

enum Brand {
  IM3
  TRI
}

enum DocFileType {
  PDF
  XLSX
  DOCX
  ZIP
  CSV
  MP4
  PNG
  JPG
}

// ============================================================================
// GLOBAL MASTER DATA (ORGANIZATION-WIDE)
// Entities in this section (Branch, Outlet, Material) represent physical,
// persistent organizational infrastructure and material catalogs.
// System is single-tenant by design (one organization). No workspace scoping.
// ============================================================================

model Branch {
  id       String       @id @default(cuid())
  code     String       @unique
  name     String
  region   String
  city     String
  status   BranchStatus @default(PENDING)
  picName  String       @default("")
  picPhone String       @default("")
  address  String       @default("")
  outlets  Outlet[]
  mous     Mou[]
}

model Outlet {
  id         String      @id @default(cuid())
  code       String      @unique
  name       String
  type       OutletType
  address    String      @default("")
  city       String      @default("")
  picName    String      @default("")
  picPhone   String      @default("")
  active     Boolean     @default(true)
  brand      Brand       @default(IM3)
  latitude   Float?
  longitude  Float?
  branchId   String
  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  placements Placement[]
  mous       Mou[]
  events     FieldEvent[]
  posts      ContentPost[]

  // Lifecycle & Approval fields
  status          OutletStatus  @default(APPROVED)
  photoUrl        String        @default("")
  submittedBy     String        @default("")
  rejectionReason String        @default("")
  approvedBy      String        @default("")
  approvedAt      DateTime?

  @@index([status])
  @@index([branchId])
}

model Material {
  id          String       @id @default(cuid())
  type        MaterialType
  name        String
  requiresMou Boolean      @default(false)
  placements  Placement[]
}

// ============================================================================
// OPERATIONAL WORK ITEMS (ORG-WIDE, SINGLE-TENANT)
// Entities below represent time-bounded marketing campaigns, contracts, tasks.
// System is single-tenant — no workspaceId scoping required.
// ============================================================================

model Placement {
  id         String          @id @default(cuid())
  outletId   String
  outlet     Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  materialId String
  material   Material        @relation(fields: [materialId], references: [id])
  mouId      String?
  mou        Mou?            @relation(fields: [mouId], references: [id], onDelete: SetNull)
  status     PlacementStatus @default(NOT_STARTED)
  brand      Brand           @default(IM3)
  date       DateTime?
  picName    String          @default("")
  photoUrl   String          @default("")
  dimensions String          @default("")
  cost       Float           @default(0)
  notes      String          @default("")

  latitude          Float?
  longitude         Float?
  shareLocationUrl  String  @default("")
  locationNotes     String  @default("")
  quarter           String  @default("Q3 2026")
  campaignTheme     String  @default("")
  isLocationValid   Boolean @default(true)
  locationDeviation Float?

  @@index([mouId])
  @@index([outletId])
  @@index([materialId])
  @@index([quarter])
  @@index([campaignTheme])
}

model Mou {
  id                String     @id @default(cuid())
  branchId          String
  branch            Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  outletId          String?
  outlet            Outlet?    @relation(fields: [outletId], references: [id], onDelete: SetNull)
  outletName        String     @default("")
  partnerName       String
  mouType           String
  submissionDate    DateTime?
  startDate         DateTime?
  endDate           DateTime?
  status            MouStatus  @default(DRAFT)
  picName           String     @default("")
  picPhone          String     @default("")
  docPath           String     @default("")
  compensationValue Float      @default(0)
  notes             String     @default("")

  placements Placement[]

  @@index([outletId])
  @@index([branchId])
}

model ContentPost {
  id            String    @id @default(cuid())
  title         String
  platform      String
  format        String
  publishDate   DateTime?
  status        String    @default("SCHEDULED")
  caption       String    @default("")
  mediaUrl      String    @default("")
  branchName    String    @default("")
  picName       String    @default("")
  revisionNotes String    @default("")
  subtasks      Json      @default("[]")
  outletId      String?
  outlet        Outlet?   @relation(fields: [outletId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([platform])
  @@index([status])
  @@index([publishDate])
  @@index([outletId])
}

model FieldEvent {
  id             String         @id @default(cuid())
  name           String
  eventType      String
  startDate      DateTime?
  endDate        DateTime?
  location       String         @default("")
  branchName     String         @default("")
  picName        String         @default("")
  status         EventStatus    @default(UPCOMING)
  budget         Float          @default(0)
  targetAttendee Int            @default(0)
  attendeeCount  Int            @default(0)
  notes          String         @default("")
  outletId       String?
  outlet         Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)
  footage        EventFootage[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([startDate])
  @@index([branchName])
  @@index([outletId])
}

model EventFootage {
  id       String     @id @default(cuid())
  eventId  String
  event    FieldEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title    String
  filePath String
  duration String     @default("")
}

model DocumentItem {
  id          String      @id @default(cuid())
  name        String
  category    String
  period      String      @default("")
  branchName  String      @default("")
  ownerPic    String      @default("")
  status      String      @default("DRAFT")
  fileType    DocFileType
  fileSizeMb  Float       @default(0)
  filePath    String
  description String      @default("")
}

model MonthlyReport {
  id           String   @id @default(cuid())
  month        String
  year         Int
  summary      Json     @default("{}")
  activities   Json     @default("[]")
  achievements Json     @default("[]")
  keyIssues    Json     @default("[]")
  actionPlans  Json     @default("[]")
}

// ============================================================================
// TASK MANAGEMENT HIERARCHY
// SpaceItem → FolderItem → ListItem → TaskItem → TaskCommentItem
// Single-tenant: SpaceItem is top-level, no workspace parent.
// ============================================================================

model SpaceItem {
  id        String      @id @default(cuid())
  name      String
  icon      String      @default("folder")
  color     String      @default("#64748B")
  statuses  Json        @default("[]")
  folders   FolderItem[]
  lists     ListItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model FolderItem {
  id        String     @id @default(cuid())
  spaceId   String
  space     SpaceItem  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name      String
  lists     ListItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([spaceId])
}

model ListItem {
  id        String      @id @default(cuid())
  spaceId   String
  space     SpaceItem   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  folderId  String?
  folder    FolderItem? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  name      String
  color     String      @default("#64748B")
  icon      String      @default("list")
  tasks     TaskItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([spaceId])
  @@index([folderId])
}

model TaskItem {
  id                String            @id @default(cuid())
  listId            String
  list              ListItem          @relation(fields: [listId], references: [id], onDelete: Cascade)
  title             String
  description       String            @default("")
  statusId          String
  priority          String            @default("normal")
  dueDate           String?
  startDate         String?
  estimatedHours    Float?
  orderIndex        Int               @default(0)
  relatedMarcomId   String?
  relatedMarcomType String?
  postPlatform      String?
  postFormat        String?
  mediaUrl          String?
  progress          Float?
  assignees         Json              @default("[]")
  tags              Json              @default("[]")
  subtasks          Json              @default("[]")
  dependencies      Json              @default("[]")
  attachments       Json              @default("[]")
  comments          TaskCommentItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([listId])
  @@index([statusId])
  @@index([listId, statusId])
  @@index([listId, orderIndex])
  @@index([relatedMarcomId])
  @@index([relatedMarcomType])
  @@index([dueDate])
  @@index([tags(ops: JsonbOps)], type: Gin)
  @@index([assignees(ops: JsonbOps)], type: Gin)
}

model TaskCommentItem {
  id          String   @id @default(cuid())
  taskId      String
  task        TaskItem @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        Json
  content     String
  attachments Json     @default("[]")
  createdAt   DateTime @default(now())

  @@index([taskId])
  @@index([userId])
  @@index([createdAt])
}

enum DbUserRole {
  ADMIN
  STAFF
  VIEWER
}

enum DbUserStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  password    String?
  googleId    String?      @unique
  avatar      String       @default("")
  role        DbUserRole   @default(STAFF)
  status      DbUserStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  lastLoginAt DateTime?

  @@index([status])
  @@index([role])
}

