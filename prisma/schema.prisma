generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum BranchStatus {
  DONE
  ON_PROGRESS
  PENDING
}

enum MouStatus {
  DRAFT
  SUBMITTED
  REVISION
  DONE
  REJECTED
  APPROVED
}

enum PlacementStatus {
  NOT_STARTED
  ON_PROGRESS
  DONE
  ISSUE
}

enum EventStatus {
  UPCOMING
  ON_PROGRESS
  COMPLETED
  CANCELLED
}

enum OutletType {
  TRADITIONAL
  MODERN_RETAIL
  EXCLUSIVE
  CAMPUS_OUTLET
}

enum OutletStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum MaterialType {
  POSTER
  SHOPBLIND
  BANNER
  BRANDING_SIGNBOARD
  OTHER_MATERIALS
}

enum Brand {
  IM3
  TRI
}

enum DocFileType {
  PDF
  XLSX
  DOCX
  ZIP
  CSV
  MP4
  PNG
  JPG
}

enum EquipmentStatus {
  AVAILABLE
  BORROWED
  MAINTENANCE
  RETIRED
}

enum BorrowStatus {
  PENDING
  APPROVED
  ACTIVE
  RETURNED
  CANCELLED
  OVERDUE
}

enum EquipmentCondition {
  GOOD
  MINOR_DAMAGE
  MAJOR_DAMAGE
  LOST
}

// ============================================================================
// GLOBAL MASTER DATA (ORGANIZATION-WIDE)
// Entities in this section (Branch, Outlet, Material) represent physical,
// persistent organizational infrastructure and material catalogs.
// System is single-tenant by design (one organization). No workspace scoping.
// ============================================================================

model Branch {
  id       String       @id @default(cuid())
  code     String       @unique
  name     String
  region   String
  city     String
  status   BranchStatus @default(PENDING)
  picName  String       @default("")
  picPhone String       @default("")
  address  String       @default("")
  outlets  Outlet[]
  mous     Mou[]
}

model Outlet {
  id         String      @id @default(cuid())
  code       String      @unique
  name       String
  type       OutletType
  address    String      @default("")
  city       String      @default("")
  picName    String      @default("")
  picPhone   String      @default("")
  active     Boolean     @default(true)
  brand      Brand       @default(IM3)
  latitude   Float?
  longitude  Float?
  branchId   String
  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  placements Placement[]
  mous       Mou[]
  events     FieldEvent[]
  posts      ContentPost[]

  // Lifecycle & Approval fields
  status          OutletStatus  @default(APPROVED)
  photoUrl        String        @default("")
  submittedBy     String        @default("")
  rejectionReason String        @default("")
  approvedBy      String        @default("")
  approvedAt      DateTime?

  @@index([status])
  @@index([branchId])
}

model Material {
  id          String       @id @default(cuid())
  type        MaterialType
  name        String
  requiresMou Boolean      @default(false)
  placements  Placement[]
}

// ============================================================================
// OPERATIONAL WORK ITEMS (ORG-WIDE, SINGLE-TENANT)
// Entities below represent time-bounded marketing campaigns, contracts, tasks.
// System is single-tenant — no workspaceId scoping required.
// ============================================================================

model Placement {
  id         String          @id @default(cuid())
  outletId   String
  outlet     Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  materialId String
  material   Material        @relation(fields: [materialId], references: [id])
  mouId      String?
  mou        Mou?            @relation(fields: [mouId], references: [id], onDelete: SetNull)
  status     PlacementStatus @default(NOT_STARTED)
  brand      Brand           @default(IM3)
  date       DateTime?
  picName    String          @default("")
  photoUrl   String          @default("")
  dimensions String          @default("")
  cost       Float           @default(0)
  notes      String          @default("")

  latitude          Float?
  longitude         Float?
  shareLocationUrl  String  @default("")
  locationNotes     String  @default("")
  quarter           String  @default("Q3 2026")
  campaignTheme     String  @default("")
  isLocationValid   Boolean @default(true)
  locationDeviation Float?

  @@index([mouId])
  @@index([outletId])
  @@index([materialId])
  @@index([quarter])
  @@index([campaignTheme])
}

model Mou {
  id                String     @id @default(cuid())
  branchId          String
  branch            Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  outletId          String?
  outlet            Outlet?    @relation(fields: [outletId], references: [id], onDelete: SetNull)
  outletName        String     @default("")
  partnerName       String
  mouType           String
  submissionDate    DateTime?
  startDate         DateTime?
  endDate           DateTime?
  status            MouStatus  @default(DRAFT)
  picName           String     @default("")
  picPhone          String     @default("")
  docPath           String     @default("")
  docPaths          String[]   @default([])
  compensationValue Float      @default(0)
  notes             String     @default("")

  placements Placement[]

  @@index([outletId])
  @@index([branchId])
}

model ContentPost {
  id            String    @id @default(cuid())
  title         String
  platform      String
  format        String
  publishDate   DateTime?
  status        String    @default("SCHEDULED")
  caption       String    @default("")
  mediaUrl      String    @default("")
  mediaAttachments Json   @default("[]")
  branchName    String    @default("")
  picName       String    @default("")
  revisionNotes String    @default("")
  subtasks      Json      @default("[]")
  outletId      String?
  outlet        Outlet?   @relation(fields: [outletId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([platform])
  @@index([status])
  @@index([publishDate])
  @@index([outletId])
}

model FieldEvent {
  id             String         @id @default(cuid())
  name           String
  eventType      String
  startDate      DateTime?
  endDate        DateTime?
  location       String         @default("")
  branchName     String         @default("")
  picName        String         @default("")
  status         EventStatus    @default(UPCOMING)
  budget         Float          @default(0)
  targetAttendee Int            @default(0)
  attendeeCount  Int            @default(0)
  notes          String         @default("")
  outletId       String?
  outlet         Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)
  mediaAttachments Json         @default("[]")
  borrowRecords  BorrowRecord[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([startDate])
  @@index([branchName])
  @@index([outletId])
}

model InventoryItem {
  id              String          @id @default(cuid())
  name            String
  code            String          @unique
  category        String
  brand           String          @default("")
  description     String          @default("")
  totalUnits      Int             @default(1)
  availableUnits  Int             @default(1)
  photoUrl        String          @default("")
  storageLocation String          @default("")
  status          EquipmentStatus @default(AVAILABLE)
  notes           String          @default("")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  borrowItems     BorrowItem[]

  @@index([status])
  @@index([category])
}

model BorrowRecord {
  id               String       @id @default(cuid())
  borrowCode       String       @unique
  borrowerName     String
  borrowerPhone    String       @default("")
  borrowerDivision String       @default("")
  picName          String       @default("")
  eventId          String?
  event            FieldEvent?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventLocation    String       @default("")
  borrowDate       DateTime
  returnDueDate    DateTime
  returnDate       DateTime?
  status           BorrowStatus @default(PENDING)
  purpose          String       @default("")
  notes            String       @default("")
  approvedBy       String       @default("")
  approvedAt       DateTime?
  returnNotes        String       @default("")
  compensationAmount Float        @default(0)
  compensationStatus String       @default("NONE") // "NONE" | "PENDING_SETTLEMENT" | "RESOLVED"
  compensationNotes  String       @default("")
  damagePhotos       String[]     @default([])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  items              BorrowItem[]

  @@index([status])
  @@index([borrowDate])
  @@index([returnDueDate])
  @@index([borrowerName])
  @@index([eventId])
}

model BorrowItem {
  id              String              @id @default(cuid())
  borrowRecordId  String
  borrowRecord    BorrowRecord        @relation(fields: [borrowRecordId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem       @relation(fields: [inventoryItemId], references: [id])
  quantity           Int                 @default(1)
  conditionOut       EquipmentCondition  @default(GOOD)
  conditionIn        EquipmentCondition? // Fallback/dominant condition
  goodUnits          Int                 @default(0)
  minorDamageUnits   Int                 @default(0)
  majorDamageUnits   Int                 @default(0)
  lostUnits          Int                 @default(0)
  notes              String              @default("")

  @@index([borrowRecordId])
  @@index([inventoryItemId])
}

model DocumentItem {
  id          String      @id @default(cuid())
  name        String
  category    String
  period      String      @default("")
  branchName  String      @default("")
  ownerPic    String      @default("")
  fileType    DocFileType
  fileSizeMb  Float       @default(0)
  filePath    String
  description String      @default("")
}

model MonthlyReport {
  id           String   @id @default(cuid())
  month        String
  year         Int
  summary      Json     @default("{}")
  activities   Json     @default("[]")
  achievements Json     @default("[]")
  keyIssues    Json     @default("[]")
  actionPlans  Json     @default("[]")
}

enum DbUserRole {
  ADMIN
  SUPERVISOR
  STAFF
  VIEWER
  WAREHOUSE
}

enum DbUserStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                String       @id @default(cuid())
  name              String
  email             String       @unique
  password          String?
  googleId          String?      @unique
  avatar            String       @default("")
  role              DbUserRole   @default(STAFF)
  status            DbUserStatus @default(PENDING)
  assignedBranchIds String[]     @default([])
  createdAt         DateTime     @default(now())
  lastLoginAt       DateTime?

  @@index([status])
  @@index([role])
}

