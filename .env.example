# Environment Variables Template
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to Git!

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (Optional / Supabase or PostgreSQL)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vrelloup"

# Supabase Auth & Realtime (Optional)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-server-only"

# Auth.js / NextAuth v5 Google OAuth Configuration
# Generate a secret via `openssl rand -base64 32` or `npx auth secret`
AUTH_SECRET="your-32-character-random-secret-for-jwt-cookies"

# Google Cloud Console OAuth 2.0 Credentials:
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"


